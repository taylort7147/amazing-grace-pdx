@page
@model MessageManager.Pages.Nucleus.Sermons.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Sermon[0].MessageId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sermon[0].NucleusChurchId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sermon[0].NucleusSermonEngineId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sermon[0].NucleusSermonId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Sermon) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MessageId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NucleusChurchId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NucleusSermonEngineId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NucleusSermonId)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
