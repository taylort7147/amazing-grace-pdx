@page
@model MessageManager.Pages.Nucleus.Playlists.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Playlist</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Playlist.Id" />
            <div class="form-group">
                
                <label asp-for="Playlist.SeriesId" class="control-label"></label>
                <input asp-for="Playlist.SeriesId" class="form-control" />
                <span asp-validation-for="Playlist.SeriesId" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="Playlist.NucleusChurchId" class="control-label"></label>
                <input asp-for="Playlist.NucleusChurchId" class="form-control" />
                <span asp-validation-for="Playlist.NucleusChurchId" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="Playlist.NucleusSermonEngineId" class="control-label"></label>
                <input asp-for="Playlist.NucleusSermonEngineId" class="form-control" />
                <span asp-validation-for="Playlist.NucleusSermonEngineId" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="Playlist.NucleusPlaylistId" class="control-label"></label>
                <input asp-for="Playlist.NucleusPlaylistId" class="form-control" />
                <span asp-validation-for="Playlist.NucleusPlaylistId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

